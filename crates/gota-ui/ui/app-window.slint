export component AppWindow inherits Window {
    in property <string> app-name;
    in property <string> tagline;
    in property <string> notice;
    in property <string> version;

    title: root.app-name;
    min-width: 360px;
    min-height: 320px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: #14161c;

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 32px;

        Text {
            text: root.app-name;
            color: #eef1f6;
            font-size: 48px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.tagline;
            color: #b8c0cc;
            font-size: 18px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.notice;
            color: #8b94a3;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "v" + root.version;
            color: #8b94a3;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
}
